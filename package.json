{
  "name": "fez-guide-tours",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "prebuild": "node scripts/cms-candidate-build-guard.mjs && npm run lint && npm test",
    "postbuild": "node --test tests/release/cms-candidate-identity.test.mjs",
    "preview": "vite preview",
    "cms:preview": "npm run build && node scripts/cms-preview.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "happy-dom": "21.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
